---
import { getCollection } from 'astro:content';
import LinkedMention from '../LinkedMention.astro';
const sorted = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<section id="work" class="work">
  <div class="rule-frame rule-frame--dark">
    <div class="section-head">
      <h2>Work</h2>
      <span class="section-span">2011 — 2026</span>
    </div>
    {sorted.map(entry => (
      <article class="work-item">
        <div class="work-item__main">
          <div class="work-item__years">{entry.data.years}</div>
          <h3>{entry.data.title}</h3>
          <div class="work-item__company"><LinkedMention text={entry.data.company} label={entry.data.company} /></div>
        </div>
        <div class="work-item__body">
          <p><LinkedMention text={entry.data.body} label={entry.data.bodyLink?.label ?? entry.data.company} href={entry.data.bodyLink?.url ?? entry.data.companyUrl} /></p>
          <ul class="work-item__highlights">
            {entry.data.highlights.map(({ lead, text }) => <li><span><strong>{lead}.</strong> {text}</span></li>)}
          </ul>
          <div class="tags">
            {entry.data.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
