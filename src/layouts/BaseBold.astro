---
import '../styles/bold/main.scss';
import Analytics from '../components/Analytics.astro';
import DocumentHead from '../components/DocumentHead.astro';
import { site } from '../data/site';
import { toRoman } from '../utils/roman';
const copyrightYear = `© ${toRoman(new Date().getFullYear())}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <DocumentHead />
  <meta name="theme-color" content="#00C1A9">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet">
  <Analytics />
</head>
<body>
  <header class="topbar">
    <a href="/" class="topbar__monogram" aria-label={site.name}>{site.monogram}</a>
    <nav class="nav" aria-label="Primary">
      {site.nav.map(link => <a href={link.href} class="nav__link">{link.label}</a>)}
    </nav>
  </header>

  <main><slot /></main>

  <footer class="footer">
    <div class="footer__inner">
      <span>{site.name}</span>
      <span>{copyrightYear}</span>
    </div>
  </footer>
</body>
</html>
