---
// Hero "E" — flooding name, meta rail, statement + CTA card.
---
<section id="top" class="hero">
  <div class="rule-frame">
    <div class="hero__name">
      <h1>Justin<br>Peterman</h1>
    </div>

    <div class="hero__meta">
      <div class="hero__meta-cell">
        <div class="label">Role</div>
        <div class="value">Product engineer</div>
      </div>
      <div class="hero__meta-cell">
        <div class="label">Formerly</div>
        <div class="value">Staff SWE, LinkedIn</div>
      </div>
      <div class="hero__meta-cell hero__meta-cell--wide">
        <div class="label">Based in</div>
        <div class="value">Brooklyn, NY</div>
      </div>
    </div>

    <div class="hero__body">
      <div class="hero__statement">
        <p>Fifteen years of frontend at scale, driven by user experience and an unreasonable commitment to craft.</p>
      </div>
      <div class="hero__cta">
        <div class="card">
          <h3>Open to<br>interesting problems.</h3>
          <div class="hero__actions">
            <a href="#contact" class="btn btn--ink">Get in touch</a>
            <a href="https://www.justinpeterman.com/resume" class="btn btn--outline">View resume</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
